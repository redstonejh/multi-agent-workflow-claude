# Multi-Agent Workflow — ignored artifacts

# Run folders are local logbooks, not source. Keep them out of version control.
# Ignore the CONTENTS of runs/ (not the dir itself) so a single demo run can be
# re-included below — git cannot re-include inside a fully-excluded directory.
runs/*
# Exception: these worked-example runs are committed as evidence —
#   the Phase-3.7 ML leakage demo (docs/06) and the Phase-3.8 code-coupling demo
#   (docs/07). They demonstrate the gates genuinely firing.
!runs/2026-06-01_ml-leakage-demo_81f1/
!runs/2026-06-02_coupling-demo_1e1e/
#   the front-end pack demo (low-contrast / a11y / budget defects -> fixed green)
!runs/2026-06-02_frontend-demo_c53d/
#   the change-verification + style-drift demo (requested change provably applied)
!runs/2026-06-02_change-verify_6cc9/

# The ML example's working artifacts are regenerable (uv run python train.py);
# the committed evidence lives in the run folder above. data.csv IS committed
# (generated once with a fixed seed) so the example is reproducible offline.
examples/ml_experiment/artifacts/

# Python
__pycache__/
*.pyc
*.pyo

# OS / editor cruft
.DS_Store
Thumbs.db
